@inherits LayoutComponentBase

<div class="page">
    <AuthorizeView>
        <Authorized>
            <header class="topbar">
                <a href="/" class="marca">Escorial &mdash; Portal Proveedores</a>
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Salir</button>
                </form>
            </header>
        </Authorized>
    </AuthorizeView>
    <main>
        @Body
    </main>
</div>
