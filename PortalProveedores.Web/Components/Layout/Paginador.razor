@if (Total > 0)
{
    <div class="paginador">
        <span>@Total @(Total == 1 ? Singular : Plural)</span>
        <span class="espacio"></span>
        <button class="sec @(Deshabilitado && hacia < 0 ? "ocupado" : null)" disabled="@(Pagina <= 1 || Deshabilitado)" @onclick="() => Ir(-1)">Anterior</button>
        <span>Página @Pagina de @Paginas</span>
        <button class="sec @(Deshabilitado && hacia > 0 ? "ocupado" : null)" disabled="@(Pagina >= Paginas || Deshabilitado)" @onclick="() => Ir(1)">Siguiente</button>
    </div>
}

@code {
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public int Tamano { get; set; } = 50;
    [Parameter] public int Total { get; set; }
    [Parameter] public string Singular { get; set; } = "resultado";
    [Parameter] public string Plural { get; set; } = "resultados";
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public EventCallback<int> OnCambio { get; set; }

    // Qué botón se apretó, para mostrar el spinner solo en ese.
    private int hacia;

    private Task Ir(int dir)
    {
        hacia = dir;
        return OnCambio.InvokeAsync(Pagina + dir);
    }

    private int Paginas => Math.Max(1, (Total + Tamano - 1) / Tamano);
}
