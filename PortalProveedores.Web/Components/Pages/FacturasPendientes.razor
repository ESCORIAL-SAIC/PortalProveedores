@page "/facturas-pendientes"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits PaginaProveedor

<PageTitle>Portal Proveedores - Facturas Pendientes</PageTitle>

<h1>Facturas pendientes</h1>

@if (Cargando)
{
    <p class="cargando">Cargando…</p>
}
else if (facturas.Count == 0)
{
    <p>No hay facturas pendientes.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Numero Factura</th>
                <th>Tipo Transaccion</th>
                <th>Proveedor</th>
                <th>Moneda</th>
                <th>Total</th>
                <th>Saldo</th>
                <th>Fecha Vencimiento</th>
                <th>Saldo Convertido</th>
                <th>Cotizacion</th>
                <th>Fecha Actualizacion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in facturas)
            {
                <tr>
                    <td>@f.FechaFactura</td>
                    <td>@f.NumeroFactura</td>
                    <td>@f.TipoTransaccion</td>
                    <td>@f.Proveedor</td>
                    <td>@f.Moneda</td>
                    <td>@f.Total</td>
                    <td>@f.Saldo</td>
                    <td>@f.FechaVencimiento</td>
                    <td>@f.SaldoConvertido</td>
                    <td>@f.Cotizacion</td>
                    <td>@f.FechaActualizacion</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<FacturaPendiente> facturas = [];

    protected override async Task Cargar() => facturas = await Api.FacturasPendientes(Proveedor);
}
