@page "/login"
@* Static SSR a propósito: la cookie de sesión se escribe en el POST a /auth/login.
   Desde un evento de componente interactivo la respuesta HTTP ya salió y no se puede. *@
@layout MainLayout

<PageTitle>Escorial - Portal Proveedores</PageTitle>

@* Es un POST normal (no un evento Blazor): se deshabilita el botón con JS inline para evitar doble envío. ui.js lo restaura si el navegador vuelve atrás. *@
<form method="post" action="/auth/login" class="card login"
      onsubmit="var b=this.querySelector('button[type=submit]');b.disabled=true;b.classList.add('ocupado');b.textContent='Ingresando…'">
    <div class="logo-login"><img src="img/logo-escorial.png" alt="Escorial" /></div>
    <h1>Ingresar</h1>

    @if (Error is not null)
    {
        <p class="error">Error en inicio de sesión</p>
    }

    <AntiforgeryToken />
    <label for="user">Usuario</label>
    <input id="user" name="user" autocomplete="username" required />

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required />

    <button type="submit" data-texto="Ingresar">Ingresar</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
